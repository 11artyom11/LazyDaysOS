{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${env:HOME}/opt/cross/lib/gcc/i686-elf/15.3.0/include/**",
                "${workspaceFolder}/**"
            ],
            "defines": [
                "__LF"
            ],
            "compilerPath": "${env:HOME}/opt/cross/bin/i686-elf-gcc",
            "compilerArgs": [
                "-ffreestanding"
            ],
            "cStandard": "gnu17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x86",
            "configurationProvider": "ms-vscode.makefile-tools"
        }
    ],
    "version": 4
}
